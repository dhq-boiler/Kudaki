<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Kudaki</AssemblyName>
    <RootNamespace>Kudaki.App</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <Product>Kudaki</Product>
    <AssemblyTitle>Kudaki</AssemblyTitle>
    <Description>Work Breakdown Structure エディター — Excel より速く/楽に。ダーク UI, YAML 保存, 砕き警告付き</Description>
    <Company>dhq_boiler</Company>
    <Authors>dhq_boiler</Authors>
    <Copyright>Copyright © 2026 dhq_boiler</Copyright>
    <PackageProjectUrl>https://github.com/dhq-boiler/Kudaki</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dhq-boiler/Kudaki</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Explorer / タスクバーが exe から拾うアイコン (multi-size ICO)。 -->
    <ApplicationIcon>Assets\kudaki.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window.Icon から pack URI (/Assets/kudaki.ico) で参照するので Resource 化。 -->
    <Resource Include="Assets\kudaki.ico" />
    <!-- SplashWindow.xaml で <Image Source="pack://.../Assets/kudaki-mark.png"/> するため。 -->
    <Resource Include="Assets\kudaki-mark.png" />
  </ItemGroup>

  <PropertyGroup>
    <!-- publish 時のみ効く。ReadyToRun で起動を速く、TrimUnused は WPF が非対応なので off。 -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <SelfContained Condition="'$(PublishSelfContained)' == 'true'">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core Kestrel を WPF プロジェクトから使うのに必要。
         ModelContextProtocol.AspNetCore は Microsoft.Extensions.* は持ってくるが、
         Kestrel 拡張 (UseKestrel/ConfigureKestrel) は Microsoft.AspNetCore.App
         shared framework にあるので FrameworkReference で参照する。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="R3" Version="1.3.1" />
    <PackageReference Include="R3Extensions.WPF" Version="1.3.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
