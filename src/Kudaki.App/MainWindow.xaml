<Window x:Class="Kudaki.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kudaki.App"
        mc:Ignorable="d"
        Title="Kudaki"
        Height="720" Width="1200"
        MinHeight="480" MinWidth="720"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Kudaki"
                       FontSize="48"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource ControlDefaultForeground}"/>
            <TextBlock Text="Excel より速く。まだ砕けます。"
                       FontSize="14"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource ControlSubtleForeground}"/>
        </StackPanel>
    </Grid>
</Window>
