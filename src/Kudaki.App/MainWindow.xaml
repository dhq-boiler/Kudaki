<Window x:Class="Kudaki.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:Kudaki.App.ViewModels"
        xmlns:conv="clr-namespace:Kudaki.App.Converters"
        xmlns:behaviors="clr-namespace:Kudaki.App.Behaviors"
        mc:Ignorable="d"
        Title="{Binding WindowTitle.Value}"
        Height="720" Width="1200"
        MinHeight="480" MinWidth="720"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=Tree}"
        behaviors:FileDropBehavior.Command="{Binding LoadFromPathAsyncCommand}"
        behaviors:FileDropBehavior.Extensions=".wbs.yaml,.yaml,.yml">

    <!-- DataContext は code-behind で IFileDialogService を注入して生成した
         MainViewModel を挿す (MVVM 純度確保のため XAML では新規生成しない)。 -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullableNumberStringConverter x:Key="NumStrConv"/>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyConv"/>

        <!-- Toolbar-like top button -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlDefaultForeground}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ControlSubtleForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree item の title 用インライン TextBox。デフォルトを継承して背景だけ透過に。 -->
        <Style x:Key="InlineTitleBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinWidth" Value="240"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlDefaultBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 詳細パネル用 TextBox。デフォルトに縦マージンだけ足す。 -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ControlSubtleForeground}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- TreeViewItem: グローバル (ControlStyles.xaml) の retemplate に、
             VM への IsExpanded / IsSelected TwoWay バインドだけを重ねる。 -->
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded.Value, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected.Value, Mode=TwoWay}"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- ファイル操作は Window スコープで完結。全部 VM のコマンドに直接バインド。 -->
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenAsyncCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveAsyncCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsAsyncCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportMarkdownAsyncCommand}"/>

        <!-- Enter / Alt+Enter は Window スコープにも配置 (Excel 的な「コミット→次行」)。
             複数行 TextBox (メモ, AcceptsReturn=True) は Enter を消費するので影響なし。
             Tree にフォーカスがあるときは Tree の InputBinding が先に食う。 -->
        <KeyBinding Key="Enter" Command="{Binding AddSiblingToSelectedCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding AddChildToSelectedCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- ==================== 上部ツールバー ==================== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource WindowTitleColour}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="新規 (Ctrl+N)"
                        Command="{Binding NewDocumentCommand}"
                        Style="{StaticResource ToolbarButton}"/>
                <Button Content="開く... (Ctrl+O)"
                        Command="{Binding OpenAsyncCommand}"
                        Style="{StaticResource ToolbarButton}"/>
                <Button Content="保存 (Ctrl+S)"
                        Command="{Binding SaveAsyncCommand}"
                        Style="{StaticResource ToolbarButton}"/>
                <Button Content="名前を付けて保存... (Ctrl+Shift+S)"
                        Command="{Binding SaveAsAsyncCommand}"
                        Style="{StaticResource ToolbarButton}"/>
                <Button Content="Markdown 出力... (Ctrl+E)"
                        Command="{Binding ExportMarkdownAsyncCommand}"
                        Style="{StaticResource ToolbarButton}"/>
                <Separator Margin="8,0" Background="{DynamicResource SubtleDividerBrush}" Width="1"/>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           FontSize="11"
                           Text="Enter=同階層追加  Alt+Enter=子追加  Tab=インデント  Shift+Tab=アウトデント  Ctrl+↑↓=並替  Delete=削除  Ctrl+E=Markdown"/>
            </StackPanel>
        </Border>

        <!-- ==================== 下部ステータスバー ==================== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding WindowTitle.Value}"
                           Foreground="{DynamicResource ControlSecondaryForeground}"/>

                <!-- 更新通知: AvailableUpdate が来たときだけ Hyperlink を出す。
                     クリックで Releases ページをブラウザで開く。 -->
                <TextBlock DockPanel.Dock="Right"
                           Margin="12,0,16,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding AvailableUpdate.Value, Converter={StaticResource NullToVis}}">
                    <Hyperlink Command="{Binding OpenReleasePageCommand}"
                               Foreground="{DynamicResource LinkForeground}"
                               TextDecorations="None">
                        <Run Text="更新あり: "/>
                        <Run Text="{Binding AvailableUpdate.Value.Tag, Mode=OneWay}"/>
                        <Run Text=" →"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock HorizontalAlignment="Right"
                           Text="{Binding StatusMessage.Value}"
                           Foreground="{DynamicResource ControlSubtleForeground}"/>
            </DockPanel>
        </Border>

        <!-- ==================== 本体: TreeView + 詳細パネル ==================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Left: TreeView -->
            <Grid Grid.Column="0" Background="{DynamicResource BackgroundColour}">

                <TreeView x:Name="Tree"
                          ItemsSource="{Binding RootTasks}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="8"
                          Foreground="{DynamicResource ControlDefaultForeground}"
                          SelectedItemChanged="Tree_SelectedItemChanged">

                    <TreeView.InputBindings>
                        <!-- Tree にフォーカスがあるときのみ発火するキー -->
                        <KeyBinding Key="Enter" Command="{Binding AddSiblingToSelectedCommand}"/>
                        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding AddChildToSelectedCommand}"/>
                        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
                        <KeyBinding Key="Tab" Command="{Binding IndentSelectedCommand}"/>
                        <KeyBinding Key="Tab" Modifiers="Shift" Command="{Binding OutdentSelectedCommand}"/>
                        <KeyBinding Key="Up" Modifiers="Ctrl" Command="{Binding MoveSelectedUpCommand}"/>
                        <KeyBinding Key="Down" Modifiers="Ctrl" Command="{Binding MoveSelectedDownCommand}"/>
                    </TreeView.InputBindings>

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TaskNodeViewModel}"
                                                   ItemsSource="{Binding Children}">
                            <!-- Grid で 6 列。* の Title が伸縮を吸収して、
                                 右側の 階層L / 進捗% / バー / 時間 / 警告 は
                                 階層深さに関係なくツリー右端に揃う。 -->
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InlineTitleBox}"
                                         MinWidth="0"
                                         HorizontalAlignment="Stretch"/>

                                <!-- 階層レベルバッジ -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource ControlDarkerBackground}"
                                        BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        Margin="0,0,4,0"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ToolTip="階層レベル">
                                    <TextBlock Text="{Binding Depth, StringFormat=L{0}}"
                                               Foreground="{DynamicResource ControlSubtleForeground}"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 進捗% -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RolledUpProgressPercent, StringFormat={}{0}%, TargetNullValue=--}"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource ControlSubtleForeground}"
                                           VerticalAlignment="Center"/>

                                <!-- 進捗バー -->
                                <ProgressBar Grid.Column="3"
                                             Width="80" Height="6"
                                             Margin="4,0,4,0"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Right"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding RolledUpProgressPercent, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"
                                             Background="{DynamicResource ControlDarkerBackground}"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource PrimaryDefaultBackground}"/>

                                <!-- 見積時間 (rolled-up) -->
                                <TextBlock Grid.Column="4"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource ControlSubtleForeground}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding RolledUpEstimateHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                    <Run Text="h"/>
                                </TextBlock>

                                <!-- 砕き警告 -->
                                <TextBlock Grid.Column="5"
                                           Text="⚠"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource WarningGlyphForeground}"
                                           ToolTip="見積 40h を超えています。もう少し砕けませんか？"
                                           Visibility="{Binding NeedsBreakdown, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- 空状態のヒント -->
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           IsHitTestVisible="False"
                           TextAlignment="Center">
                    <Run Text="Enter キーで最初のタスクを追加"/>
                    <LineBreak/>
                    <Run Text="（ツリーがフォーカスされている状態で）"
                         FontSize="11"/>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RootTasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource SubtleDividerBrush}"
                          ShowsPreview="False"/>

            <!-- Right: プロパティパネル -->
            <Grid Grid.Column="2"
                  Background="{DynamicResource SidebarBackground}"
                  Visibility="{Binding SelectedTask.Value, Converter={StaticResource NullToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel DataContext="{Binding SelectedTask.Value}">

                        <TextBlock Text="詳細"
                                   FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource ControlDefaultForeground}"/>

                        <TextBlock Text="タイトル" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PropTitle"
                                 AutomationProperties.AutomationId="PropTitle"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="見積 (h)" Style="{StaticResource FieldLabel}"/>
                                <TextBox AutomationProperties.AutomationId="PropEstimate"
                                         Text="{Binding EstimateHours, Converter={StaticResource NumStrConv}, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         IsEnabled="{Binding IsLeaf}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="残 (h)"/>
                                    <Run Text=" — 毎日更新" Foreground="{DynamicResource ControlSubtleForeground}" FontSize="10"/>
                                </TextBlock>
                                <TextBox AutomationProperties.AutomationId="PropRemaining"
                                         Text="{Binding RemainingHours, Converter={StaticResource NumStrConv}, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         IsEnabled="{Binding IsLeaf}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="担当者" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Assignee, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="期限" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DueDate, Converter={StaticResource DateOnlyConv}, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,8"/>

                        <TextBlock Text="メモ" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="140"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- 集計セクション -->
                        <Border BorderBrush="{DynamicResource SubtleDividerBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,8,0,8"/>

                        <TextBlock Text="集計 (葉から派生)" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="見積合計: " Foreground="{DynamicResource ControlSecondaryForeground}"/>
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource ControlDefaultForeground}">
                                <Run Text="{Binding RolledUpEstimateHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                <Run Text="h"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="残合計: " Foreground="{DynamicResource ControlSecondaryForeground}"/>
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource ControlDefaultForeground}">
                                <Run Text="{Binding RolledUpRemainingHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                <Run Text="h"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="消化: " Foreground="{DynamicResource ControlSecondaryForeground}"/>
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource ControlDefaultForeground}">
                                <Run Text="{Binding RolledUpActualHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                <Run Text="h"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="進捗: " Foreground="{DynamicResource ControlSecondaryForeground}"/>
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource ControlDefaultForeground}"
                                       Text="{Binding RolledUpProgressPercent, StringFormat={}{0}%, TargetNullValue=--, Mode=OneWay}"/>
                        </Grid>

                        <!-- 砕き警告表示 -->
                        <Border Margin="0,12,0,0"
                                Padding="10"
                                Background="{DynamicResource ControlDarkerBackground}"
                                BorderBrush="{DynamicResource WarningGlyphForeground}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding NeedsBreakdown, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="16"
                                           Foreground="{DynamicResource WarningGlyphForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Foreground="{DynamicResource ControlDefaultForeground}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <Run Text="このタスクは葉なのに見積 40h を超えてるっす。"/>
                                    <LineBreak/>
                                    <Run Text="もう少し砕けませんか？"
                                         Foreground="{DynamicResource ControlSubtleForeground}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </DockPanel>
</Window>
