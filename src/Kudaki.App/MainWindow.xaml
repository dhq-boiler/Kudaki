<Window x:Class="Kudaki.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:Kudaki.App.ViewModels"
        xmlns:models="clr-namespace:Kudaki.App.Models"
        xmlns:conv="clr-namespace:Kudaki.App.Converters"
        xmlns:behaviors="clr-namespace:Kudaki.App.Behaviors"
        xmlns:loc="clr-namespace:Kudaki.App.Properties"
        mc:Ignorable="d"
        Title="{Binding WindowTitle.Value}"
        Icon="pack://application:,,,/Assets/kudaki.ico"
        Height="720" Width="1200"
        MinHeight="480" MinWidth="720"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="{DynamicResource WindowBorderColour}"
        BorderThickness="1"
        FocusManager.FocusedElement="{Binding ElementName=Tree}"
        behaviors:FileDropBehavior.Command="{Binding LoadFromPathCommand}"
        behaviors:FileDropBehavior.Extensions=".wbs.yaml,.yaml,.yml">

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight = 32: 上端 32px を「タイトルバー扱い」にする。
             ResizeBorderThickness = 5: ウィンドウ端 5px をリサイズ hit test に。
             GlassFrameThickness = 0 で Aero ガラス無効化。
             UseAeroCaptionButtons = False で Windows のキャプションボタンを描画しない
             (Kudaki 自前のボタンを使う)。 -->
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- DataContext は code-behind で IFileDialogService を注入して生成した
         MainViewModel を挿す (MVVM 純度確保のため XAML では新規生成しない)。 -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullableNumberStringConverter x:Key="NumStrConv"/>
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyConv"/>

        <!-- Toolbar-like top button -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlDefaultForeground}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ControlSubtleForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree item の title 用インライン TextBox。デフォルトを継承して背景だけ透過に。 -->
        <Style x:Key="InlineTitleBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinWidth" Value="240"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlDefaultBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 詳細パネル用 TextBox。デフォルトに縦マージンだけ足す。 -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ControlSubtleForeground}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- TreeViewItem: グローバル (ControlStyles.xaml) の retemplate に、
             VM への IsExpanded / IsSelected TwoWay バインドだけを重ねる。 -->
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded.Value, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected.Value, Mode=TwoWay}"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- ファイル操作は Window スコープで完結。全部 VM のコマンドに直接バインド。
             CommunityToolkit.Mvvm は [RelayCommand] on *Async メソッドから Async サフィックスを
             落とした名前でコマンドを生成する (OpenAsync → OpenCommand)。 -->
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewDocumentCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportMarkdownCommand}"/>
        <!-- VS Code / Visual Studio 系標準の Ctrl+, で環境設定を開く -->
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenPreferencesCommand}"/>

        <!-- Enter / Alt+Enter は Window スコープにも配置 (Excel 的な「コミット→次行」)。
             複数行 TextBox (メモ, AcceptsReturn=True) は Enter を消費するので影響なし。
             Tree にフォーカスがあるときは Tree の InputBinding が先に食う。 -->
        <KeyBinding Key="Enter" Command="{Binding AddSiblingToSelectedCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding AddChildToSelectedCommand}"/>
    </Window.InputBindings>

    <!-- Landing overlay (splash 相当) を DockPanel の上に載せるため Grid で wrap。 -->
    <Grid>
    <DockPanel>

        <!-- ==================== WindowChrome カスタムタイトルバー ==================== -->
        <Grid DockPanel.Dock="Top"
              Height="32"
              Background="{DynamicResource WindowTitleColour}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- タイトル -->
                <ColumnDefinition Width="Auto"/> <!-- Menu -->
                <ColumnDefinition Width="*"/>    <!-- ドラッグ領域 + 中央ファイル名 -->
                <ColumnDefinition Width="Auto"/> <!-- 更新通知 -->
                <ColumnDefinition Width="Auto"/> <!-- min/max/close -->
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Kudaki"
                       Margin="12,0,4,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ControlDefaultForeground}"/>

            <!-- Menu 本体。WindowChrome.IsHitTestVisibleInChrome=True を立てないと
                 CaptionHeight のドラッグ領域に食われてクリックが通らない。 -->
            <Menu Grid.Column="1"
                  Margin="8,0,0,0"
                  VerticalAlignment="Stretch"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="{x:Static loc:Strings.Menu_File}">
                    <MenuItem Header="{x:Static loc:Strings.Menu_File_New}"
                              InputGestureText="Ctrl+N"
                              Command="{Binding NewDocumentCommand}"/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_File_Open}"
                              InputGestureText="Ctrl+O"
                              Command="{Binding OpenCommand}"/>
                    <Separator/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_File_Save}"
                              InputGestureText="Ctrl+S"
                              Command="{Binding SaveCommand}"/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_File_SaveAs}"
                              InputGestureText="Ctrl+Shift+S"
                              Command="{Binding SaveAsCommand}"/>
                    <Separator/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_File_ExportMarkdown}"
                              InputGestureText="Ctrl+E"
                              Command="{Binding ExportMarkdownCommand}"/>
                    <Separator/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_File_Exit}"
                              InputGestureText="Alt+F4"
                              Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.Menu_Edit}">
                    <MenuItem Header="{x:Static loc:Strings.Menu_Edit_AddSibling}"
                              InputGestureText="Enter"
                              Command="{Binding AddSiblingToSelectedCommand}"/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_Edit_AddChild}"
                              InputGestureText="Alt+Enter"
                              Command="{Binding AddChildToSelectedCommand}"/>
                    <Separator/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_Edit_Indent}"
                              InputGestureText="Tab"
                              Command="{Binding IndentSelectedCommand}"/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_Edit_Outdent}"
                              InputGestureText="Shift+Tab"
                              Command="{Binding OutdentSelectedCommand}"/>
                    <Separator/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_Edit_MoveUp}"
                              InputGestureText="Ctrl+↑"
                              Command="{Binding MoveSelectedUpCommand}"/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_Edit_MoveDown}"
                              InputGestureText="Ctrl+↓"
                              Command="{Binding MoveSelectedDownCommand}"/>
                    <Separator/>
                    <MenuItem Header="{x:Static loc:Strings.Menu_Edit_Delete}"
                              InputGestureText="Delete"
                              Command="{Binding DeleteSelectedCommand}"/>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.Menu_Tools}">
                    <MenuItem Header="{x:Static loc:Strings.Menu_Tools_Preferences}"
                              InputGestureText="Ctrl+,"
                              Command="{Binding OpenPreferencesCommand}"/>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.Menu_Help}">
                    <MenuItem Header="{x:Static loc:Strings.Menu_Help_OpenRepository}"
                              Command="{Binding OpenRepositoryCommand}"/>
                </MenuItem>
            </Menu>

            <!-- 中央のドラッグ領域: ファイル名を薄く表示、ここは Chrome の hit test を有効のままにして
                 ドラッグでウィンドウ移動を効かせる (WindowChrome のデフォルト) -->
            <TextBlock Grid.Column="2"
                       Text="{Binding WindowTitle.Value}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource ControlSubtleForeground}"
                       FontSize="12"
                       IsHitTestVisible="False"/>

            <!-- 更新通知 -->
            <TextBlock Grid.Column="3"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       WindowChrome.IsHitTestVisibleInChrome="True"
                       Visibility="{Binding AvailableUpdate.Value, Converter={StaticResource NullToVis}}">
                <Hyperlink Command="{Binding OpenReleasePageCommand}"
                           Foreground="{DynamicResource LinkForeground}"
                           TextDecorations="None">
                    <Run Text="{x:Static loc:Strings.Titlebar_UpdateAvailable_Prefix}"/>
                    <Run Text="{Binding AvailableUpdate.Value.Tag, Mode=OneWay}"/>
                    <Run Text=" →"/>
                </Hyperlink>
            </TextBlock>

            <!-- Window control buttons: min / max / restore / close -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}"
                        Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                        ToolTip="{x:Static loc:Strings.Caption_Minimize}">
                    <Path Data="M0,5 L10,5"
                          Stroke="{DynamicResource ControlDefaultForeground}"
                          StrokeThickness="1"
                          SnapsToDevicePixels="True"/>
                </Button>
                <!-- 最大化ボタン: 通常時のみ表示 -->
                <Button Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                        ToolTip="{x:Static loc:Strings.Caption_Maximize}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="M0,0 L10,0 L10,10 L0,10 Z"
                          Stroke="{DynamicResource ControlDefaultForeground}"
                          StrokeThickness="1"
                          Fill="Transparent"
                          SnapsToDevicePixels="True"/>
                </Button>
                <!-- 元に戻すボタン: 最大化時のみ表示 -->
                <Button Command="{x:Static SystemCommands.RestoreWindowCommand}"
                        ToolTip="{x:Static loc:Strings.Caption_Restore}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="M2,0 L10,0 L10,8 M0,2 L8,2 L8,10 L0,10 Z"
                          Stroke="{DynamicResource ControlDefaultForeground}"
                          StrokeThickness="1"
                          Fill="Transparent"
                          SnapsToDevicePixels="True"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        ToolTip="{x:Static loc:Strings.Caption_Close}">
                    <Path Data="M0,0 L10,10 M0,10 L10,0"
                          Stroke="{DynamicResource ControlDefaultForeground}"
                          StrokeThickness="1"
                          SnapsToDevicePixels="True"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 下部ステータスバー ==================== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{x:Static loc:Strings.StatusBar_ShortcutHint}"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           FontSize="11"/>
                <TextBlock HorizontalAlignment="Right"
                           Text="{Binding StatusMessage.Value}"
                           Foreground="{DynamicResource ControlSubtleForeground}"/>
            </DockPanel>
        </Border>

        <!-- ==================== 本体: TreeView + 詳細パネル ==================== -->
        <!-- v0.3 で ActiveDocument.Value (DocumentViewModel) を DataContext にする。
             内部 bind (RootTasks / SelectedTask.Value 等) は DocumentViewModel から
             直接解決される。次 commit でこの Grid を TabControl.ContentTemplate 内へ移す。 -->
        <Grid DataContext="{Binding ActiveDocument.Value}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Left: TreeView -->
            <Grid Grid.Column="0" Background="{DynamicResource BackgroundColour}">

                <TreeView x:Name="Tree"
                          ItemsSource="{Binding RootTasks}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="8"
                          Foreground="{DynamicResource ControlDefaultForeground}"
                          SelectedItemChanged="Tree_SelectedItemChanged">

                    <TreeView.InputBindings>
                        <!-- Tree にフォーカスがあるときのみ発火するキー -->
                        <KeyBinding Key="Enter" Command="{Binding AddSiblingToSelectedCommand}"/>
                        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding AddChildToSelectedCommand}"/>
                        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
                        <KeyBinding Key="Tab" Command="{Binding IndentSelectedCommand}"/>
                        <KeyBinding Key="Tab" Modifiers="Shift" Command="{Binding OutdentSelectedCommand}"/>
                        <KeyBinding Key="Up" Modifiers="Ctrl" Command="{Binding MoveSelectedUpCommand}"/>
                        <KeyBinding Key="Down" Modifiers="Ctrl" Command="{Binding MoveSelectedDownCommand}"/>
                    </TreeView.InputBindings>

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TaskNodeViewModel}"
                                                   ItemsSource="{Binding Children}">
                            <!-- Grid で 6 列。* の Title が伸縮を吸収して、
                                 右側の 階層L / 進捗% / バー / 時間 / 警告 は
                                 階層深さに関係なくツリー右端に揃う。
                                 Tag は MainViewModel を掴んで ContextMenu 内から届くように。 -->
                            <Grid HorizontalAlignment="Stretch"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <!-- 葉タスクだと意味がないので Disabled。判定は Binding + PlacementTarget 経由。 -->
                                        <MenuItem Header="{x:Static loc:Strings.Tree_ContextMenu_ShowArrowDiagram}"
                                                  Command="{Binding PlacementTarget.Tag.ShowArrowDiagramCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsLeaf, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InlineTitleBox}"
                                         MinWidth="0"
                                         HorizontalAlignment="Stretch"
                                         PreviewMouseLeftButtonDown="TitleBox_PreviewMouseLeftButtonDown"
                                         PreviewKeyDown="TitleBox_PreviewKeyDown"/>

                                <!-- 階層レベルバッジ -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource ControlDarkerBackground}"
                                        BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        Margin="0,0,4,0"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ToolTip="{x:Static loc:Strings.Tree_Tooltip_HierarchyLevel}">
                                    <TextBlock Text="{Binding Depth, StringFormat=L{0}}"
                                               Foreground="{DynamicResource ControlSubtleForeground}"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 進捗% -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RolledUpProgressPercent, StringFormat={}{0}%, TargetNullValue=--}"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource ControlSubtleForeground}"
                                           VerticalAlignment="Center"/>

                                <!-- 進捗バー -->
                                <ProgressBar Grid.Column="3"
                                             Width="80" Height="6"
                                             Margin="4,0,4,0"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Right"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding RolledUpProgressPercent, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"
                                             Background="{DynamicResource ControlDarkerBackground}"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource PrimaryDefaultBackground}"/>

                                <!-- 見積時間 (rolled-up) -->
                                <TextBlock Grid.Column="4"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource ControlSubtleForeground}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding RolledUpEstimateHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                    <Run Text="h"/>
                                </TextBlock>

                                <!-- 砕き警告 -->
                                <TextBlock Grid.Column="5"
                                           Text="⚠"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource WarningGlyphForeground}"
                                           ToolTip="{x:Static loc:Strings.Tree_Tooltip_NeedsBreakdown}"
                                           Visibility="{Binding NeedsBreakdown, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- 空状態のヒント -->
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           IsHitTestVisible="False"
                           TextAlignment="Center">
                    <Run Text="{x:Static loc:Strings.Tree_Empty_Hint_Line1}"/>
                    <LineBreak/>
                    <Run Text="{x:Static loc:Strings.Tree_Empty_Hint_Line2}"
                         FontSize="11"/>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RootTasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource SubtleDividerBrush}"
                          ShowsPreview="False"/>

            <!-- Right: プロパティパネル -->
            <Grid Grid.Column="2"
                  Background="{DynamicResource SidebarBackground}"
                  Visibility="{Binding SelectedTask.Value, Converter={StaticResource NullToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel DataContext="{Binding SelectedTask.Value}">

                        <TextBlock Text="{x:Static loc:Strings.Detail_Header}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource ControlDefaultForeground}"/>

                        <TextBlock Text="{x:Static loc:Strings.Detail_Title}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PropTitle"
                                 AutomationProperties.AutomationId="PropTitle"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.Detail_Estimate}" Style="{StaticResource FieldLabel}"/>
                                <TextBox AutomationProperties.AutomationId="PropEstimate"
                                         Text="{Binding EstimateHours, Converter={StaticResource NumStrConv}, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         IsEnabled="{Binding IsLeaf}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="{x:Static loc:Strings.Detail_Remaining}"/>
                                    <Run Text="{x:Static loc:Strings.Detail_Remaining_Suffix}" Foreground="{DynamicResource ControlSubtleForeground}" FontSize="10"/>
                                </TextBlock>
                                <TextBox AutomationProperties.AutomationId="PropRemaining"
                                         Text="{Binding RemainingHours, Converter={StaticResource NumStrConv}, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         IsEnabled="{Binding IsLeaf}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.Detail_Assignee}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Assignee, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="{x:Static loc:Strings.Detail_DueDate}" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DueDate, Converter={StaticResource DateOnlyConv}, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,8"/>

                        <TextBlock Text="{x:Static loc:Strings.Detail_Notes}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="140"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- 先行タスク (依存, FS 固定) -->
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="{x:Static loc:Strings.Detail_Predecessors}"/>
                            <Run Text="{x:Static loc:Strings.Detail_Predecessors_Suffix}"
                                 Foreground="{DynamicResource ControlSubtleForeground}" FontSize="10"/>
                        </TextBlock>

                        <!-- 現在の先行タスクをチップで表示、× で解除 -->
                        <ItemsControl ItemsSource="{Binding Predecessors}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TaskNodeViewModel}">
                                    <Border Background="{DynamicResource ChipBackground}"
                                            BorderBrush="{DynamicResource ChipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource ChipForeground}"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="180"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Content="✕"
                                                    Command="{Binding DataContext.RemovePredecessorFromSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="6,0,0,0"
                                                    Padding="0"
                                                    Width="14" Height="14"
                                                    FontSize="10"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource ChipRemoveForeground}"
                                                    ToolTip="{x:Static loc:Strings.Detail_Predecessor_RemoveTooltip}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 追加: SelectablePredecessors から選ぶ ComboBox。選ぶと即追加してリセット -->
                        <ComboBox x:Name="PredecessorCombo"
                                  ItemsSource="{Binding DataContext.SelectablePredecessors.Value, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Title"
                                  SelectionChanged="PredecessorCombo_SelectionChanged"
                                  Margin="0,0,0,8"
                                  ToolTip="{x:Static loc:Strings.Detail_Predecessor_AddTooltip}"/>

                        <!-- 集計セクション -->
                        <Border BorderBrush="{DynamicResource SubtleDividerBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,8,0,8"/>

                        <TextBlock Text="{x:Static loc:Strings.Detail_Summary_Header}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:Strings.Detail_Summary_EstimateTotal}" Foreground="{DynamicResource ControlSecondaryForeground}"/>
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource ControlDefaultForeground}">
                                <Run Text="{Binding RolledUpEstimateHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                <Run Text="h"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:Strings.Detail_Summary_RemainingTotal}" Foreground="{DynamicResource ControlSecondaryForeground}"/>
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource ControlDefaultForeground}">
                                <Run Text="{Binding RolledUpRemainingHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                <Run Text="h"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:Strings.Detail_Summary_ActualTotal}" Foreground="{DynamicResource ControlSecondaryForeground}"/>
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource ControlDefaultForeground}">
                                <Run Text="{Binding RolledUpActualHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                <Run Text="h"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:Strings.Detail_Summary_Progress}" Foreground="{DynamicResource ControlSecondaryForeground}"/>
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource ControlDefaultForeground}"
                                       Text="{Binding RolledUpProgressPercent, StringFormat={}{0}%, TargetNullValue=--, Mode=OneWay}"/>
                        </Grid>

                        <!-- 砕き警告表示 -->
                        <Border Margin="0,12,0,0"
                                Padding="10"
                                Background="{DynamicResource ControlDarkerBackground}"
                                BorderBrush="{DynamicResource WarningGlyphForeground}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding NeedsBreakdown, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="16"
                                           Foreground="{DynamicResource WarningGlyphForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Foreground="{DynamicResource ControlDefaultForeground}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <Run Text="{x:Static loc:Strings.Detail_Warning_Line1}"/>
                                    <LineBreak/>
                                    <Run Text="{x:Static loc:Strings.Detail_Warning_Line2}"
                                         Foreground="{DynamicResource ControlSubtleForeground}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </DockPanel>

    <!-- ==================== Diff Overlay (MCP propose_changes レビュー) ==================== -->
    <!-- DataContext を ActiveDocument.Value に切り替え、per-doc の CurrentPendingSet を bind する。
         v0.3 で MCP propose_changes を documentId 単位に分離した際にもここが正しい doc に届く土台。
         Visibility は Landing と同じ理由で code-behind の Subscribe で切り替える。 -->
    <Grid x:Name="DiffOverlay"
          DataContext="{Binding ActiveDocument.Value}"
          Panel.ZIndex="90"
          Background="#B3000000"
          Visibility="Collapsed">
        <Border Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                MaxWidth="760"
                MaxHeight="620"
                Margin="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <DockPanel>
                <!-- Header -->
                <Border DockPanel.Dock="Top"
                        Padding="20,16"
                        BorderBrush="{DynamicResource SubtleDividerBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Diff_Header}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ControlDefaultForeground}"/>
                        <TextBlock FontSize="11"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource ControlSubtleForeground}">
                            <Run Text="{x:Static loc:Strings.Diff_SourceLabel}"/>
                            <Run Text="{Binding CurrentPendingSet.Value.Source, Mode=OneWay, TargetNullValue={x:Static loc:Strings.Diff_Source_Unknown}}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding CurrentPendingSet.Value.Changes.Count, Mode=OneWay, StringFormat={x:Static loc:Strings.Diff_Changes_CountFormat}}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Buttons (bottom, docked before scrollable content) -->
                <Border DockPanel.Dock="Bottom"
                        Padding="20,12"
                        BorderBrush="{DynamicResource SubtleDividerBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static loc:Strings.Diff_Reject}"
                                Command="{Binding RejectCurrentPendingCommand}"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                Foreground="{DynamicResource ControlDefaultForeground}"
                                BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"/>
                        <Button Content="{x:Static loc:Strings.Diff_Approve}"
                                Command="{Binding ApproveCurrentPendingCommand}"
                                Padding="16,6"
                                Background="{DynamicResource PrimaryDefaultBackground}"
                                Foreground="{DynamicResource PrimaryForeground}"
                                BorderBrush="{DynamicResource PrimaryDefaultBorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Changes list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <ItemsControl ItemsSource="{Binding CurrentPendingSet.Value.Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PendingChange}">
                                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Op}" Value="Add">
                                                    <Setter Property="Background" Value="#402D7A3D"/>
                                                    <Setter Property="BorderBrush" Value="#FF2D7A3D"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Op}" Value="Delete">
                                                    <Setter Property="Background" Value="#407A2D2D"/>
                                                    <Setter Property="BorderBrush" Value="#FF7A2D2D"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Op}" Value="Update">
                                                    <Setter Property="Background" Value="#407A5A2D"/>
                                                    <Setter Property="BorderBrush" Value="#FF7A5A2D"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Consolas"
                                                       FontWeight="Bold"
                                                       MinWidth="14"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ControlDefaultForeground}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Op}" Value="Add">
                                                                <Setter Property="Text" Value="+"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Op}" Value="Delete">
                                                                <Setter Property="Text" Value="-"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Op}" Value="Update">
                                                                <Setter Property="Text" Value="~"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Op, Mode=OneWay}"
                                                       Margin="6,0,10,0"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ControlSubtleForeground}"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ControlDefaultForeground}"
                                                       FontWeight="SemiBold">
                                                <Run Text="{Binding After.Title, Mode=OneWay, TargetNullValue=''}"/>
                                                <Run Text="{Binding Before.Title, Mode=OneWay, TargetNullValue=''}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TaskId, Mode=OneWay, StringFormat=' ({0})'}"
                                                       FontSize="10"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ControlSubtleForeground}"/>
                                        </StackPanel>

                                        <!-- Update 時: フィールド差分の一覧 -->
                                        <ItemsControl ItemsSource="{Binding FieldDiffs}"
                                                      Margin="22,6,0,0">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FieldDiffs.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:FieldDiff}">
                                                    <TextBlock FontSize="11"
                                                               Margin="0,1"
                                                               Foreground="{DynamicResource ControlDefaultForeground}">
                                                        <Run Text="{Binding FieldName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding Before, Mode=OneWay, TargetNullValue={x:Static loc:Strings.Common_Value_Unset}}"
                                                             Foreground="#FFE59E9E"/>
                                                        <Run Text="  →  "/>
                                                        <Run Text="{Binding After, Mode=OneWay, TargetNullValue={x:Static loc:Strings.Common_Value_Unset}}"
                                                             Foreground="#FF9EE59E"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>

    <!-- ==================== 起動ランディング (splash 相当) ==================== -->
    <!-- MainViewModel.IsLoading が true のあいだ TreeView 側を覆う overlay。
         プログレスバーは実際のロード進捗 (LoadingPercent) と同期。
         各起動フェーズが MainViewModel.ReportLoading(percent, status) を呼ぶ。 -->
    <Grid x:Name="LandingOverlay"
          Panel.ZIndex="100"
          Background="#FF0A0605"
          Visibility="Visible">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/kudaki-mark.png"
                   Width="140" Height="140"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,40"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{x:Static loc:Strings.Landing_Product}"
                       FontSize="44"
                       FontWeight="Light"
                       Foreground="#FFEBEBEB"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="{x:Static loc:Strings.Landing_Tagline}"
                       FontSize="11"
                       Foreground="#FF8E8E8E"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="24,0,24,20">
            <ProgressBar Height="2"
                         Minimum="0" Maximum="100"
                         Value="{Binding LoadingPercent.Value, Mode=OneWay}"
                         Background="#FF1A1414"
                         Foreground="#FFA0332C"
                         BorderThickness="0"
                         Margin="0,0,0,14"/>
            <Grid>
                <TextBlock Text="{Binding LoadingStatus.Value}"
                           FontSize="11"
                           Foreground="#FF8E8E8E"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="LandingVersionText"
                           FontSize="11"
                           Foreground="#FF8E8E8E"
                           HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
