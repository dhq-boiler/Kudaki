<Window x:Class="Kudaki.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Kudaki.App.Properties"
        mc:Ignorable="d"
        Title="{x:Static loc:Strings.About_Title}"
        Height="560" Width="620"
        MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        Icon="pack://application:,,,/Assets/kudaki.ico"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        BorderBrush="{DynamicResource WindowBorderColour}"
        BorderThickness="1"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="4"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- タイトルバー (ConfirmDialog と同意匠) -->
        <Grid DockPanel.Dock="Top" Height="28" Background="{DynamicResource WindowTitleColour}">
            <TextBlock Text="{x:Static loc:Strings.About_Title}"
                       Margin="12,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource ControlDefaultForeground}"
                       FontSize="12"/>
            <Button HorizontalAlignment="Right" Width="40" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource ControlDefaultForeground}"
                    Click="Close_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Content="×" FontSize="16"/>
        </Grid>

        <!-- ボタンバー -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Button Content="{x:Static loc:Strings.Common_Close}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource DialogPrimaryButton}"
                    Click="Close_Click"
                    IsCancel="True"
                    IsDefault="True"/>
        </Border>

        <Grid Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ヘッダー: ロゴ + 製品情報 -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="pack://application:,,,/Assets/kudaki-mark.png"
                       Width="88" Height="88"
                       VerticalAlignment="Top"
                       Margin="0,0,20,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Kudaki"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource ControlDefaultForeground}"/>
                    <TextBlock Text="{x:Static loc:Strings.About_Tagline}"
                               FontSize="13"
                               Foreground="{DynamicResource ControlSecondaryForeground}"
                               Margin="0,2,0,8"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="VersionText"
                               FontSize="12"
                               Foreground="{DynamicResource ControlDefaultForeground}"/>
                    <TextBlock Text="{x:Static loc:Strings.About_Copyright}"
                               FontSize="11"
                               Foreground="{DynamicResource ControlSubtleForeground}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ライセンス / リポジトリ -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{x:Static loc:Strings.About_License_Label}"
                           FontSize="12"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{x:Static loc:Strings.About_License_Value}"
                           FontSize="12"
                           Foreground="{DynamicResource ControlDefaultForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{x:Static loc:Strings.About_Repository_Label}"
                           FontSize="12"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           FontSize="12"
                           VerticalAlignment="Center">
                    <Hyperlink x:Name="RepositoryLink"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{DynamicResource LinkForeground}">
                        <Run x:Name="RepositoryLinkText"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>

            <!-- OSS セクション見出し -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="{x:Static loc:Strings.About_OssHeader}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ControlDefaultForeground}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{x:Static loc:Strings.About_OssIntro}"
                           FontSize="11"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- OSS 一覧 -->
            <Border Grid.Row="3"
                    Background="{DynamicResource ContainerBackground}"
                    BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                    BorderThickness="1"
                    Padding="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ItemsControl x:Name="OssItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SubtleDividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ControlDefaultForeground}"/>
                                            <TextBlock Text="{Binding VersionText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ControlSubtleForeground}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="4,0,0,1"/>
                                            <TextBlock Text="{Binding LicenseText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ControlSecondaryForeground}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="4,0,0,1"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Hyperlink NavigateUri="{Binding Url}"
                                                       RequestNavigate="Hyperlink_RequestNavigate"
                                                       Foreground="{DynamicResource LinkForeground}">
                                                <Run Text="{Binding UrlText}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
