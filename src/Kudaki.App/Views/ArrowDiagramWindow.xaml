<Window x:Class="Kudaki.App.Views.ArrowDiagramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kudaki.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title.Value}"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        BorderBrush="{DynamicResource WindowBorderColour}"
        BorderThickness="1">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource WindowTitleColour}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <TextBlock Text="{Binding Title.Value}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ControlDefaultForeground}"/>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock Foreground="{DynamicResource ControlSubtleForeground}" FontSize="11">
                <Run Text="AON 記法 (箱=タスク、矢印=先行→後続、FS)。"/>
                <Run Text="⚡" Foreground="{DynamicResource WarningGlyphForeground}"/>
                <Run Text="印はこの階層の外に先行タスクを持つ (親 P の外部からの依存があるタスク)。"/>
            </TextBlock>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource BackgroundColour}">
            <ItemsControl>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                            <!-- Edges (奥) -->
                            <ItemsControl ItemsSource="{Binding Edges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArrowDiagramEdge}">
                                        <!-- Line 本体と矢頭を 1 つの Path でまとめて描くのが理想だが、
                                             ここでは Line + 三角 Polygon を絶対座標で置く簡易版。 -->
                                        <Canvas>
                                            <Line X1="{Binding FromX}" Y1="{Binding FromY}"
                                                  X2="{Binding ToX}"   Y2="{Binding ToY}"
                                                  Stroke="{DynamicResource ControlSecondaryForeground}"
                                                  StrokeThickness="1.5"/>
                                            <!-- 矢頭は ToX,ToY を先端に、少し戻った位置に三角。
                                                 単純化のため向き固定 (右向き矢頭)。 -->
                                            <Polygon Points="0,-4 8,0 0,4"
                                                     Fill="{DynamicResource ControlSecondaryForeground}"
                                                     Canvas.Left="{Binding ToX}"
                                                     Canvas.Top="{Binding ToY}">
                                                <Polygon.RenderTransform>
                                                    <TranslateTransform X="-8"/>
                                                </Polygon.RenderTransform>
                                            </Polygon>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Nodes (手前) -->
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ArrowDiagramNode}">
                                        <Border Width="{Binding Width}" Height="{Binding Height}"
                                                Background="{DynamicResource ContainerBackground}"
                                                BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0">
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="⚡" FontSize="12"
                                                               Foreground="{DynamicResource WarningGlyphForeground}"
                                                               ToolTip="この階層の外に先行タスクがあります"
                                                               Visibility="{Binding HasExternalInbound, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Task.Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ControlDefaultForeground}"/>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1"
                                                           VerticalAlignment="Bottom"
                                                           Foreground="{DynamicResource ControlSubtleForeground}"
                                                           FontSize="11">
                                                    <Run Text="見積 "/>
                                                    <Run Text="{Binding Task.RolledUpEstimateHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                                    <Run Text="h / 残 "/>
                                                    <Run Text="{Binding Task.RolledUpRemainingHours, StringFormat={}{0:0.#}, Mode=OneWay}"/>
                                                    <Run Text="h"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
