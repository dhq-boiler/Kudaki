<Window x:Class="Kudaki.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Kudaki.App.Properties"
        mc:Ignorable="d"
        Height="200" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        BorderBrush="{DynamicResource WindowBorderColour}"
        BorderThickness="1"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Primary (Save) / Secondary (Discard / Cancel) は UpdatePromptWindow と同じ意匠。
             DRY を優先するなら Themes/ControlStyles.xaml に上げるべきだが、まず現状パターンを踏襲。 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryDefaultBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDefaultBorderBrush}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryMouseOverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ControlDefaultBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlDefaultForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlDefaultBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- タイトルバー -->
        <Grid DockPanel.Dock="Top" Height="28" Background="{DynamicResource WindowTitleColour}">
            <TextBlock x:Name="DialogTitleText"
                       Margin="12,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource ControlDefaultForeground}"
                       FontSize="12"/>
            <Button HorizontalAlignment="Right" Width="40" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource ControlDefaultForeground}"
                    Click="Cancel_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Content="×" FontSize="16"/>
        </Grid>

        <!-- ボタンバー -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:Strings.CloseTab_Button_Cancel}"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        IsCancel="True"/>
                <Button Content="{x:Static loc:Strings.CloseTab_Button_Discard}"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="Discard_Click"/>
                <Button Content="{x:Static loc:Strings.CloseTab_Button_Save}"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Border>

        <!-- 本文 -->
        <StackPanel Margin="24,20">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ControlSecondaryForeground}"
                       LineHeight="22"/>
        </StackPanel>
    </DockPanel>
</Window>
