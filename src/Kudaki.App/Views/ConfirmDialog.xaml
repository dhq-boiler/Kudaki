<Window x:Class="Kudaki.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Kudaki.App.Properties"
        mc:Ignorable="d"
        Height="200" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        BorderBrush="{DynamicResource WindowBorderColour}"
        BorderThickness="1"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Primary (Save) / Secondary (Discard / Cancel) は Themes/ControlStyles.xaml の
         DialogPrimaryButton / DialogSecondaryButton を共通利用 (Diff Overlay 承認/却下と同意匠)。 -->

    <DockPanel>
        <!-- タイトルバー -->
        <Grid DockPanel.Dock="Top" Height="28" Background="{DynamicResource WindowTitleColour}">
            <TextBlock x:Name="DialogTitleText"
                       Margin="12,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource ControlDefaultForeground}"
                       FontSize="12"/>
            <Button HorizontalAlignment="Right" Width="40" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource ControlDefaultForeground}"
                    Click="Cancel_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Content="×" FontSize="16"/>
        </Grid>

        <!-- ボタンバー -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:Strings.CloseTab_Button_Cancel}"
                        Margin="0,0,8,0"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="Cancel_Click"
                        IsCancel="True"/>
                <Button Content="{x:Static loc:Strings.CloseTab_Button_Discard}"
                        Margin="0,0,8,0"
                        Style="{StaticResource DialogSecondaryButton}"
                        Click="Discard_Click"/>
                <Button Content="{x:Static loc:Strings.CloseTab_Button_Save}"
                        Style="{StaticResource DialogPrimaryButton}"
                        Click="Save_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Border>

        <!-- 本文 -->
        <StackPanel Margin="24,20">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ControlSecondaryForeground}"
                       LineHeight="22"/>
        </StackPanel>
    </DockPanel>
</Window>
