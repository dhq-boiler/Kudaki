<Window x:Class="Kudaki.App.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kudaki.App.ViewModels"
        xmlns:loc="clr-namespace:Kudaki.App.Properties"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Width="640" Height="360"
        MinWidth="560" MinHeight="320"
        d:DataContext="{d:DesignInstance Type=vm:PreferencesViewModel}"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/kudaki.ico"
        BorderBrush="{DynamicResource WindowBorderColour}"
        BorderThickness="1"
        ResizeMode="CanResize">

    <!-- MainWindow と同じく自前タイトルバー方式 (WPF 標準のライトなキャプションだと
         ダークテーマから浮くため)。CaptionHeight=32 で上端をドラッグ領域扱いに。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- カテゴリごとの中身。SelectedCategory.Key で DataTemplate を切り替える。
             将来カテゴリを増やすときはここに DataTemplate を 1 個足すだけ (Kata と同方針)。 -->

        <!-- General: 表示言語のみ -->
        <DataTemplate x:Key="GeneralCategoryTemplate">
            <StackPanel Margin="4">
                <TextBlock Text="{Binding DataContext.LanguageLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="12"
                           Foreground="{DynamicResource ControlDefaultForeground}"
                           Margin="0,6,0,4"/>
                <ComboBox ItemsSource="{Binding DataContext.LanguageOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding DataContext.SelectedLanguageOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          MinWidth="240"
                          HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding DataContext.LanguageHint, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           Margin="0,8,0,6"/>
            </StackPanel>
        </DataTemplate>

        <!-- MCP: 軽量変更の自動反映 (v03-mcp-auto-apply t-settings-model) -->
        <DataTemplate x:Key="McpCategoryTemplate">
            <StackPanel Margin="4">
                <CheckBox Content="{Binding DataContext.McpAutoApplyLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                          IsChecked="{Binding DataContext.AutoApplyEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          Foreground="{DynamicResource ControlDefaultForeground}"
                          Margin="0,6,0,6"/>
                <TextBlock Text="{Binding DataContext.McpAutoApplyHint, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           Margin="0,4,0,6"/>

                <!-- 承認待ちの通知 (v03-approval-attention t-settings-ui) -->
                <Separator Margin="0,10,0,10" Background="{DynamicResource SubtleDividerBrush}"/>
                <TextBlock Text="{Binding DataContext.NotifyHeader, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ControlDefaultForeground}"
                           Margin="0,0,0,2"/>
                <TextBlock Text="{Binding DataContext.NotifyHint, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource ControlSubtleForeground}"
                           Margin="0,0,0,8"/>
                <CheckBox Content="{Binding DataContext.NotifySoundLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                          IsChecked="{Binding DataContext.NotifySound, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          Foreground="{DynamicResource ControlDefaultForeground}"
                          Margin="0,0,0,6"/>
                <CheckBox Content="{Binding DataContext.NotifyFlashLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                          IsChecked="{Binding DataContext.NotifyFlashTaskbar, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          Foreground="{DynamicResource ControlDefaultForeground}"
                          Margin="0,0,0,6"/>
                <CheckBox Content="{Binding DataContext.NotifyRestoreLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                          IsChecked="{Binding DataContext.NotifyRestoreIfMinimized, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          Foreground="{DynamicResource ControlDefaultForeground}"
                          Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataContext.NotifyRepeatLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ControlDefaultForeground}"
                               Margin="0,0,8,0"/>
                    <TextBox Text="{Binding DataContext.NotifyRepeatIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="56"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 右詳細ペインの ContentControl に付ける Style。SelectedCategory.Key の
             DataTrigger で ContentTemplate を切り替える。 -->
        <Style x:Key="CategoryContentStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource GeneralCategoryTemplate}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCategory.Key}" Value="general">
                    <Setter Property="ContentTemplate" Value="{StaticResource GeneralCategoryTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedCategory.Key}" Value="mcp">
                    <Setter Property="ContentTemplate" Value="{StaticResource McpCategoryTemplate}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ダイアログの OK/Cancel ボタン共通 style。
             Kata の DarkMessageBoxButton (Themes/Theme.xaml) を忠実に移植:
             - 角 CornerRadius=2、BorderThickness=1.5、Cursor=Hand
             - Hover: 枠色を GlowBlueBright にアニメ (150ms) + DropShadow で青いグロー、
               背景を微妙に明るく (#FF383838)
             - Focus (IsFocused): 枠を GlowBlue + 弱いグロー (BlurRadius=8, Opacity=0.45)
             - Pressed: 背景 = #FF1A6CC0、枠 = GlowBlueBright (非アニメの即時反転)
             - Disabled: Bright な背景 + subtle な foreground
             GlowBlue / GlowBlueBright は Palette.Dark.xaml と同じキー名なので Kata と同じ発色。 -->
        <Style x:Key="DialogButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource ControlDefaultBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlDefaultBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlDefaultForeground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glowEffect"
                                                  BlurRadius="0"
                                                  Opacity="0"
                                                  ShadowDepth="0"
                                                  Color="{StaticResource GlowBlue}"/>
                            </Border.Effect>
                            <ContentPresenter x:Name="contentPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="{StaticResource GlowBlueBright}"
                                                            Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="12"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.6"
                                                             Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#FF383838"
                                                            Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0"
                                                             Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            To="{StaticResource GlowBlue}"
                                                            Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="8"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.45"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0"
                                                             Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF1A6CC0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource GlowBlueBright}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource ControlBrightDefaultBackground}"/>
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{DynamicResource ControlBrightDefaultBorderBrush}"/>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground"
                                        Value="{DynamicResource ControlSubtleForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ==================== 自前タイトルバー ==================== -->
        <Grid DockPanel.Dock="Top"
              Height="32"
              Background="{DynamicResource WindowTitleColour}">
            <TextBlock Text="{Binding DialogTitle}"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ControlDefaultForeground}"/>
            <!-- MainWindow の右上 × と完全に同じ見た目にする。glyph は文字 "×" ではなく
                 Path で細い直線 2 本を交差させて描く (MainWindow.xaml と 1:1)。
                 CloseCaptionButton は Themes/ControlStyles.xaml に merge 済みで hover 時は
                 背景が赤 (#FFE81123) に変わる、その挙動もそのまま継承。 -->
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource CloseCaptionButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="{x:Static loc:Strings.Caption_Close}"
                    Command="{Binding CancelCommand}">
                <Path Data="M0,0 L10,10 M0,10 L10,0"
                      Stroke="{DynamicResource ControlDefaultForeground}"
                      StrokeThickness="1"
                      SnapsToDevicePixels="True"/>
            </Button>
        </Grid>

        <!-- ==================== 下段ボタンバー ==================== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding OkLabel}"
                        Style="{StaticResource DialogButton}"
                        IsDefault="True"
                        Command="{Binding OkCommand}"/>
                <Button Content="{Binding CancelLabel}"
                        Style="{StaticResource DialogButton}"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>

        <!-- ==================== 本体: 左カテゴリ / 右詳細 ==================== -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: カテゴリリスト -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,8,0">
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource ControlDefaultForeground}"
                         Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PreferencesCategory}">
                            <TextBlock Text="{Binding DisplayName}" Padding="6,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 右: カテゴリごとの詳細 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource ContainerBackground}"
                    BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <ContentControl Content="{Binding SelectedCategory}"
                                Style="{StaticResource CategoryContentStyle}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
