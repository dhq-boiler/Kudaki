<Window x:Class="Kudaki.App.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kudaki.App.ViewModels"
        xmlns:conv="clr-namespace:Kudaki.App.Converters"
        mc:Ignorable="d"
        Title="{Binding Title.Value}"
        Height="260" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BackgroundColour}"
        Foreground="{DynamicResource ControlDefaultForeground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        BorderBrush="{DynamicResource WindowBorderColour}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryDefaultBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDefaultBorderBrush}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryMouseOverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlDisabledBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ControlSubtleForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ControlDefaultBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlDefaultForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlDefaultBorderBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- タイトルバー -->
        <Grid DockPanel.Dock="Top" Height="28" Background="{DynamicResource WindowTitleColour}">
            <TextBlock Text="{Binding Title.Value}"
                       Margin="12,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource ControlDefaultForeground}"
                       FontSize="12"/>
            <Button HorizontalAlignment="Right" Width="40" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource ControlDefaultForeground}"
                    Command="{Binding CancelCommand}"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Content="×" FontSize="16"/>
        </Grid>

        <!-- ボタンバー -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ContainerBackground}"
                BorderBrush="{DynamicResource SubtleDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            Visibility="{Binding IsDownloading.Value, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding ProgressText.Value}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ControlSubtleForeground}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="ブラウザで開く"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenInBrowserCommand}"
                            IsEnabled="{Binding IsDownloading.Value, Converter={StaticResource NullToVis}, ConverterParameter=inverse}"/>
                    <Button Content="今すぐ更新"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding CanAutoUpdate}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 本文 -->
        <StackPanel Margin="24,20">
            <TextBlock Text="{Binding Message.Value}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ControlSecondaryForeground}"
                       LineHeight="22"
                       Margin="0,0,0,16"/>

            <!-- 進捗バー (DL 中のみ) -->
            <ProgressBar Height="6"
                         Minimum="0" Maximum="1"
                         Value="{Binding ProgressFraction.Value, Mode=OneWay}"
                         Visibility="{Binding IsDownloading.Value, Converter={StaticResource NullToVis}}"/>

            <!-- エラーメッセージ -->
            <TextBlock Text="{Binding ErrorMessage.Value}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerForeground}"
                       Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage.Value, Converter={StaticResource NullToVis}}"/>
        </StackPanel>
    </DockPanel>
</Window>
