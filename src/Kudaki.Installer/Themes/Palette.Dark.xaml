<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Kudaki のダークパレット。
          PaperPlane (Palette.Dark.xaml) / VARA / Kata と同系統に揃えている。
          キーは DynamicResource で引く前提。将来ライトテーマを足すときは
          同じキーを同じ順で持つ Palette.Light.xaml を用意して差し替える。  -->

    <!--  Window / surface  -->
    <SolidColorBrush x:Key="BackgroundColour" Color="#FF232323"/>
    <SolidColorBrush x:Key="WindowBorderColour" Color="#FF343434"/>
    <SolidColorBrush x:Key="WindowTitleColour" Color="#FF242424"/>
    <SolidColorBrush x:Key="ContainerBackground" Color="#FF272727"/>
    <SolidColorBrush x:Key="ContainerBorder" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#22FFFFFF"/>

    <!--  Foreground  -->
    <SolidColorBrush x:Key="ControlDefaultForeground" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="ControlSecondaryForeground" Color="#FFB4B4B4"/>
    <SolidColorBrush x:Key="ControlSubtleForeground" Color="#FF8E8E8E"/>

    <!--  Control surfaces  -->
    <SolidColorBrush x:Key="ControlDarkerBackground" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ControlDarkerBorderBrush" Color="#FF2F2F2F"/>
    <SolidColorBrush x:Key="ControlDefaultBackground" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="ControlDefaultBorderBrush" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="ControlBrightDefaultBackground" Color="#FF343434"/>
    <SolidColorBrush x:Key="ControlBrightDefaultBorderBrush" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#FF424242"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#FF464646"/>
    <SolidColorBrush x:Key="ControlMouseOverBackground" Color="#FF3F3F3F"/>
    <SolidColorBrush x:Key="ControlMouseOverBorderBrush" Color="#FF505050"/>
    <SolidColorBrush x:Key="ControlSelectedBackground" Color="#FF2C4B7A"/>
    <SolidColorBrush x:Key="ControlSelectedBorderBrush" Color="#FF3C5D8F"/>
    <SolidColorBrush x:Key="ControlSelectedMouseOverBackground" Color="#FF365991"/>
    <SolidColorBrush x:Key="ControlSelectedMouseOverBorderBrush" Color="#FF4272B4"/>

    <!--  Primary (blue) accent  -->
    <SolidColorBrush x:Key="PrimaryDefaultBackground" Color="#FF2084E8"/>
    <SolidColorBrush x:Key="PrimaryDefaultBorderBrush" Color="#FF3294E8"/>
    <SolidColorBrush x:Key="PrimaryMouseOverBackground" Color="#FF3296FA"/>
    <SolidColorBrush x:Key="PrimaryMouseOverBorderBrush" Color="#FF50A4FA"/>
    <SolidColorBrush x:Key="PrimaryPressedBackground" Color="#FF1565C0"/>
    <SolidColorBrush x:Key="PrimaryPressedBorderBrush" Color="#FF1976D2"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="LinkForeground" Color="#FF6BB6F5"/>

    <!--  警告 / 危険。砕き警告は WarningGlyphForeground を使う  -->
    <SolidColorBrush x:Key="WarningGlyphForeground" Color="#FFFFC060"/>
    <SolidColorBrush x:Key="DangerBackground" Color="#FF7A1F1F"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFB03A3A"/>
    <SolidColorBrush x:Key="DangerForeground" Color="#FFFFECEC"/>

    <!--  Hover / selection overlay  -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="SelectedOverlayBrush" Color="#332084E8"/>

    <!--  ScrollBar thumb  -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#66808080"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#996E6E6E"/>
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#CC4D4D4D"/>

    <!--  Glow  -->
    <Color x:Key="GlowBlue">#FF2084E8</Color>
    <Color x:Key="GlowBlueBright">#FF50A4FA</Color>

</ResourceDictionary>
